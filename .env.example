# Copy deploy/config/app.env.example to /etc/mprovifilesharing/app.env.
# Generate three distinct 32-byte secrets; never commit actual configuration.
NODE_ENV=production
APP_ORIGIN=https://files.tspro.fr
MOODLE_ORIGIN=https://moodle.tspro.fr
DATABASE_URL=postgresql://mprovi@localhost/mprovifilesharing?host=/var/run/postgresql
STORAGE_ROOT=/srv/ressources
STORAGE_MODE=bind
STORAGE_BIND_SOURCE=/var/lib/mprovifilesharing-data
STORAGE_MARKER=REPLACE_WITH_UUID
SESSION_SECRET=REPLACE_WITH_64_HEX_DIGITS
MOODLE_SHARED_SECRET=REPLACE_WITH_ANOTHER_64_HEX_DIGITS
MOODLE_CATALOG_SECRET=REPLACE_WITH_A_THIRD_64_HEX_DIGITS
MOODLE_CLIENT_ID=mprovifilesharing
MOODLE_KEY_ID=v1
PORT=3000
