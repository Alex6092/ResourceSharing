# Encrypted Restic repository outside the application VM.
RESTIC_REPOSITORY=sftp:backup-user@backup.example.org:/backups/mprovifilesharing
RESTIC_PASSWORD_FILE=/etc/mprovifilesharing/restic-password
RESTIC_CACHE_DIR=/var/lib/mprovi/restic-cache
# Provision the backup SSH key under /var/lib/mprovi/.ssh, permissions 0600.
# Pin the backup host in known_hosts before enabling the timer.
