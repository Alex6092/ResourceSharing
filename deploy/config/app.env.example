NODE_ENV=production
APP_ORIGIN=https://files.example.org
MOODLE_ORIGIN=https://moodle.example.org
DATABASE_URL=postgresql://mprovi@localhost/mprovifilesharing?host=/var/run/postgresql
STORAGE_ROOT=/srv/ressources
STORAGE_MARKER=REPLACE_WITH_UUID
SESSION_SECRET=REPLACE_WITH_DISTINCT_64_HEX_DIGITS
MOODLE_SHARED_SECRET=REPLACE_WITH_DISTINCT_64_HEX_DIGITS
MOODLE_CATALOG_SECRET=REPLACE_WITH_DISTINCT_64_HEX_DIGITS
MOODLE_CLIENT_ID=mprovifilesharing
MOODLE_KEY_ID=v1
PORT=3000
MIN_FREE_BYTES=10737418240
MAX_ACTIVE_UPLOADS=6
MAX_USER_UPLOADS=3
UPLOAD_IDLE_DAYS=7
RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90
