[Unit]
Description=MProviFileSharing Apache transfer statistics
After=postgresql.service

[Service]
Type=oneshot
User=mprovi
Group=adm
SupplementaryGroups=mprovi-read
WorkingDirectory=/opt/mprovifilesharing/current
EnvironmentFile=/etc/mprovifilesharing/app.env
ExecStart=/opt/mprovifilesharing/node/bin/node packages/core/src/cli.ts import-access-log
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=256M
